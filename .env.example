# API
API_PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://asissto:asissto@localhost:5432/asissto?schema=public

# Redis (BullMQ) - se usa a partir de fase 3
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Patient OTP - hasta fase 4 se loguea a consola en vez de mandar por WhatsApp
OTP_SIMULATED=true
OTP_DEV_CODE=000000

# Kapso (fase 4)
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=

# Google Calendar (fase 4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/integrations/google/callback
